# ============ اجباری ============
# توکن ربات مدیریتی (از BotFather)
BOT_TOKEN=123456:ABC-DEF...
# از my.telegram.org می‌گیری
API_ID=123456
API_HASH=abcdef0123456789abcdef0123456789
# آیدی عددی ادمین‌ها با کاما جدا کن (از @userinfobot بگیر)
ADMIN_IDS=111111111

# ============ دیتابیس و ساعت ============
DATABASE_PATH=data/bot.db
TIMEZONE=Asia/Tehran

# ============ محدودیت منصفانه (جایگزین کردیت؛ برای محافظت از سهمیه رایگان AI) ============
# سقف پستِ پردازش‌شده با AI در روز برای هر کاربر
DAILY_POST_LIMIT=60
# سقف تعداد کانال مبدا و مقصد هر کاربر
MAX_SOURCES=5
MAX_DESTS=2

# ============ زمان‌بندی ============
# هر چند ثانیه کانال‌های مبدا چک شوند
POLL_INTERVAL_SEC=180
# هر چند ثانیه صف انتشار چک شود
QUEUE_TICK_SEC=60
# هر چند دقیقه اخبار خودکار چک شود
NEWS_TICK_MIN=20

# ============ کلیدهای اولیه ادمین (اختیاری ولی fortement پیشنهادی) ============
# با کاما جدا کن. آموزش گرفتن رایگان در README هست.
GROQ_KEYS=
GEMINI_KEYS=
OPENROUTER_KEYS=
MISTRAL_KEYS=
# ترتیب اولویت ارائه‌دهنده‌ها در روتر
AI_ORDER=groq,mistral,gemini,openrouter

# ============ اختیاری ============
# سشن آماده پارسر کانال‌های عمومی (اگه خالی باشه، ادمین با /parser_login می‌سازه)
PARSER_SESSION=
# کلید نوسان برای قیمت دقیق‌تر دلار/طلا (اختیاری)
NAVASAN_KEY=
# کلید Tavily برای بررسی شایعه قوی‌تر (اختیاری، وگرنه جستجوی رایگان DuckDuckGo)
TAVILY_KEY=
